{
  "name": "kiss-ai-hub",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -p tsconfig.app.json --noEmit && npm run check:server && npm run check:boundaries && npm test -- --run",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@cursor/sdk": "^1.0.12",
    "@google/design.md": "^0.1.1",
    "@mozilla/readability": "^0.6.0",
    "@uiw/react-codemirror": "^4.25.9",
    "express": "^5.2.1",
    "linkedom": "^0.18.12",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
